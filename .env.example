# ==============================================================================
# Enterprise AI Knowledge & Research Copilot - Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables for your target deployment.
# Never commit real credentials, production API keys, or secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Environment Configuration
# ------------------------------------------------------------------------------
# ENVIRONMENT: "development" | "testing" | "production"
# In production, strict safeguards require DEBUG=false, strong SECRET_KEY, and disabled SQLite/local fallbacks.
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Enterprise AI Knowledge & Research Copilot"
VERSION="0.1.0"
API_V1_STR="/api/v1"
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# SECRET_KEY: Used for session security and token signatures.
# In production, this MUST be set to a secure, random string >= 32 characters.
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key

# CORS: Comma-separated list or JSON array of allowed origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# ------------------------------------------------------------------------------
# 2. Relational Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=enterprise_copilot

# Optional explicit connection strings (override discrete POSTGRES_* settings if set)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_copilot
# DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/enterprise_copilot

# Fallback to local SQLite when PostgreSQL is unavailable (DEVELOPMENT/TESTING ONLY)
# Must be set to false in production environments.
DATABASE_SQLITE_FALLBACK=true
DATABASE_SQLITE_PATH=./data/copilot_dev.db

# Database Connection Pool Settings (PostgreSQL AsyncAdaptedQueuePool)
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30.0
DATABASE_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 3. Vector Database (Qdrant)
# ------------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=enterprise_knowledge
QDRANT_TIMEOUT_SECONDS=5.0

# Fallback to in-memory Qdrant client when remote server is unavailable (DEVELOPMENT ONLY)
# Must be set to false in production environments.
QDRANT_LOCAL_FALLBACK=true

# ------------------------------------------------------------------------------
# 4. LLM & Grounded Generation Providers
# ------------------------------------------------------------------------------
# LLM_PROVIDER: "mock" | "openai" | "anthropic" | "local"
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=https://api.anthropic.com
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=30.0

# Citation verification thresholds
CITATION_MIN_SUPPORT_THRESHOLD=0.40
CITATION_PARTIAL_SUPPORT_THRESHOLD=0.20

# ------------------------------------------------------------------------------
# 5. Embeddings & Lexical Retrieval
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64
BM25_INDEX_PATH=./data/indexes/bm25_index.pkl
RETRIEVAL_DEFAULT_TOP_K=10
RETRIEVAL_RRF_K=60

# ------------------------------------------------------------------------------
# 6. Neural Cross-Encoder Reranking
# ------------------------------------------------------------------------------
RERANKER_PROVIDER=bge
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_BATCH_SIZE=32
RERANKER_ENABLED=true
RERANKER_CANDIDATE_TOP_K=10
RETRIEVAL_FINAL_TOP_K=5
CONTEXT_MAX_TOKENS=2000
CONTEXT_MAX_CHARACTERS=8000
MIN_RELEVANCE_THRESHOLD=

# ------------------------------------------------------------------------------
# 7. In-Memory Thread-Safe LRU Caching
# ------------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_EMBEDDING_MAX_SIZE=20000
CACHE_EMBEDDING_TTL_SECONDS=86400
CACHE_RERANKER_MAX_SIZE=20000
CACHE_RERANKER_TTL_SECONDS=86400

# ------------------------------------------------------------------------------
# 8. Storage, Ingestion & API Limits
# ------------------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=50
MAX_SUBQUERIES_LIMIT=5
MAX_RETRIEVAL_TOP_K=50
API_REQUEST_TIMEOUT_SECONDS=60.0

# ------------------------------------------------------------------------------
# 9. Monitoring & Observability Stack (Optional Docker Profile)
# ------------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
