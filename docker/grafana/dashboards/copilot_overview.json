      "id": 2,
      "title": "HTTP Request Rate by Endpoint",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(copilot_requests_total[1m])) by (endpoint, status)",
          "legendFormat": "{{endpoint}} ({{status}})"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
